# =====================================================================
# .gitignore — Rendy Rental Batam
# Proteksi Kredensial, Database, Media Berat, dan File Sistem
# =====================================================================

# 1. Environment & Kredensial Rahasia (SANGAT KRUSIAL - JANGAN DI-PUSH)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
credentials.json
token.json

# Pengecualian: file template contoh konfigurasi boleh di-push
!.env.example

# 2. Database & Data Sensitif (SQL Dump, Seed Lokal, Data Pelanggan)
*.sql
*.dump
*.sqlite
*.sqlite3
*.db
*.rdb

# 3. File Media Berat / Video Mentah (>10MB)
# Video promo sebaiknya di-host di Cloud Storage, CDN, atau YouTube / Vimeo
*.mp4
*.mov
*.avi
*.wmv
src/videos/*.mp4

# 4. Dependency & Package Manager
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Build Outputs & Hosting Cache
dist/
build/
.cache/
.netlify/
.output/

# 6. Sistem Operasi & Cache File
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*.swo

# 7. IDE & Editor Config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# 8. Log & File Sementara
logs/
*.log

# 9. Scratch & Catatan Agent / Internal Antigravity
scratch/
brain/
