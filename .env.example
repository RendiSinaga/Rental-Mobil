# Template Konfigurasi Lingkungan (Aman untuk di-push ke Git)
# Salin file ini menjadi `.env` lalu isi dengan kredensial proyek lokal Anda.
# PENTING: File `.env` yang berisi key asli TIDAK AKAN di-push ke GitHub.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
